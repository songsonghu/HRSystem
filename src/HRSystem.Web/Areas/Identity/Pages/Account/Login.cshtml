@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrap">
    <div class="card auth-card">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="brand-mark"><i class="bi bi-people-fill"></i></span>
            <span class="fw-semibold">HR System</span>
        </div>
        <h1 class="h4 fw-semibold mb-1">Welcome back</h1>
        <p class="text-muted mb-4">Sign in with your work email.</p>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Sign in</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
