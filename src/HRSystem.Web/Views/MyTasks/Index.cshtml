@model IReadOnlyList<RequestItemDto>
@{
    ViewData["Title"] = "Account Checklist";
}

<h2>Account Checklist</h2>
<p class="page-subtitle">
    Account items of the departments you handle. Open or disable the account, then click <b>Complete</b>
    (or <b>Reject</b> if it cannot be done); your department approvers then approve it.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have no pending items.</div>
}

@foreach (var i in Model)
{
    <partial name="_AccountItemCard" model="i" />
}
