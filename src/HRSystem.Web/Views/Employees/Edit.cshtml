@model EmployeeEditDto
@{
    ViewData["Title"] = "Edit Employee";
}

<h2>Edit Employee</h2>
<hr />

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="EmployeeNo" class="form-label">Staff No.</label>
        <input asp-for="EmployeeNo" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Position" class="form-label">Position</label>
        <input asp-for="Position" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Department" class="form-label">Department</label>
        <select asp-for="Department" class="form-select" asp-items="ViewBag.Departments">
            <option value="">-- select department --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Employee Category</label>
        <select asp-for="Category" class="form-select"
                asp-items="Html.GetEnumSelectList<EmployeeCategory>()"></select>
        <div class="form-text">Determines which account request form (Staff or AE/Sales/SA) applies to this employee.</div>
    </div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="JoinDate" class="form-label">Join Date</label>
            <input asp-for="JoinDate" type="date" class="form-control" />
        </div>
        <div class="col mb-3">
            <label asp-for="ResignDate" class="form-label">Resign Date</label>
            <input asp-for="ResignDate" type="date" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select"
                asp-items="Html.GetEnumSelectList<EmployeeStatus>()"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Attachments</label>
        @if (Model.Attachments.Count == 0)
        {
            <p class="form-control-plaintext text-muted">No files uploaded.</p>
        }
        else
        {
            <ul class="list-group">
            @foreach (var attachment in Model.Attachments)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @attachment.FileName
                    <small class="text-muted">@(attachment.FileSize / 1024) KB</small>
                </li>
            }
            </ul>
        }
    </div>
    <div class="mb-3">
        <label for="replacementAttachments" class="form-label">Replace attachments</label>
        <input id="replacementAttachments" name="replacementAttachments" type="file" class="form-control" multiple
               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
        <div class="form-text">Selecting files replaces all existing attachments. Leave empty to keep them.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
