@model IReadOnlyList<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees</h2>
    <a class="btn btn-success" asp-action="Create">+ New Employee</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search name / no. / dept" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Emp No.</th><th>Name</th><th>Department</th><th>Position</th>
            <th>Category</th><th>Join Date</th><th>Status</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.EmployeeNo</td>
            <td>@e.Name</td>
            <td>@e.Department</td>
            <td>@e.Position</td>
            <td><span class="badge bg-light text-dark border">@(e.Category == EmployeeCategory.AE ? "AE/Sales/SA" : "Staff")</span></td>
            <td>@e.JoinDate.ToString("yyyy-MM-dd")</td>
            <td>
                <span class="badge @(e.Status == EmployeeStatus.Active ? "bg-success" : "bg-secondary")">@e.Status</span>
            </td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                <a class="btn btn-sm btn-outline-info" asp-controller="Requests" asp-action="Create" asp-route-employeeId="@e.Id">Request</a>
                <a class="btn btn-sm btn-outline-warning" asp-controller="Offboarding" asp-action="Employee" asp-route-id="@e.Id">Offboard</a>
                <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this employee?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
