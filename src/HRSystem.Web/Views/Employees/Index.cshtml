@using Microsoft.AspNetCore.Mvc.Rendering
@model HRSystem.Application.Common.PagedResult<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
    var query = (EmployeeListQuery)ViewBag.Query;
    var departments = (List<SelectListItem>)ViewBag.Departments;
    departments.ForEach(d => d.Selected = d.Value == query.DepartmentId?.ToString());
    var searching = !string.IsNullOrWhiteSpace(query.Name) || !string.IsNullOrWhiteSpace(query.StaffNo) || query.DepartmentId is not null;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Employees</h2>
        <div class="text-muted small">@Model.TotalCount @(Model.TotalCount == 1 ? "person" : "people")@(searching ? " found" : null)</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Employee</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1" for="name">Name</label>
        <input type="text" id="name" name="name" value="@query.Name" class="form-control" placeholder="Employee name" />
    </div>
    <div class="col-sm-6 col-lg-2">
        <label class="form-label small text-muted mb-1" for="staffNo">Staff No.</label>
        <input type="text" id="staffNo" name="staffNo" value="@query.StaffNo" class="form-control" placeholder="Staff no." />
    </div>
    <div class="col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1" for="departmentId">Department</label>
        <select id="departmentId" name="departmentId" class="form-select" asp-items="departments">
            <option value="">All departments</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-pageSize="@Model.PageSize">Clear</a>
        }
    </div>
    <div class="col-auto ms-lg-auto"><partial name="_PageSizeSelect" model="Model.PageSize" /></div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th><th>Staff No.</th><th>Department</th><th>Position</th>
            <th>Category</th><th>Join Date</th><th>Status</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.Items)
    {
        <tr>
            <td>
                <a class="person text-reset" asp-action="Details" asp-route-id="@e.Id">
                    <partial name="_Avatar" model="e.Name" />
                    <span>
                        <span class="fw-medium d-block">@e.Name</span>
                        @if (!string.IsNullOrWhiteSpace(e.Email)) { <span class="text-muted small">@e.Email</span> }
                    </span>
                </a>
            </td>
            <td class="text-muted">@e.EmployeeNo</td>
            <td>@if (e.DepartmentId is null) { <span class="badge bg-warning">Unassigned</span> } else { @e.Department }</td>
            <td>@e.Position</td>
            <td><span class="badge bg-light">@(e.Category == EmployeeCategory.AE ? "AE/Sales/SA" : "Staff")</span></td>
            <td>@e.JoinDate.ToString("yyyy-MM-dd")</td>
            <td><span class="badge @(e.Status == EmployeeStatus.Active ? "bg-success" : "bg-secondary")">@e.Status</span></td>
            <td class="text-nowrap text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                <div class="dropdown d-inline-block">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@e.Id"><i class="bi bi-person me-2"></i>View profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Requests" asp-action="Create" asp-route-employeeId="@e.Id"><i class="bi bi-person-badge me-2"></i>Account request</a></li>
                        @if (User.HasPermission(Permissions.OffboardingExport))
                        {
                            <li><a class="dropdown-item" asp-controller="Offboarding" asp-action="Employee" asp-route-id="@e.Id"><i class="bi bi-key me-2"></i>Accounts held</a></li>
                        }
                        @if (e.Status == EmployeeStatus.Active && (User.HasPermission(Permissions.OnboardingManage) || User.HasPermission(Permissions.DeparturesManage)))
                        {
                            <li><hr class="dropdown-divider" /></li>
                            @if (User.HasPermission(Permissions.OnboardingManage))
                            {
                                <li><a class="dropdown-item" asp-controller="Onboarding" asp-action="Create" asp-route-employeeId="@e.Id"><i class="bi bi-person-plus me-2"></i>Start onboarding</a></li>
                            }
                            @if (User.HasPermission(Permissions.DeparturesManage))
                            {
                                <li><a class="dropdown-item text-danger" asp-controller="Departures" asp-action="Create" asp-route-employeeId="@e.Id"><i class="bi bi-person-dash me-2"></i>Start departure</a></li>
                            }
                        }
                    </ul>
                </div>
            </td>
        </tr>
    }
    @if (Model.TotalCount == 0)
    {
        <tr><td colspan="8" class="empty-state">No employees found.</td></tr>
    }
    </tbody>
</table>

<partial name="_Pager" model="Model" />
