@model EmployeeDto
@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>
<hr />
<dl class="row col-md-6">
    <dt class="col-sm-4">Employee No.</dt><dd class="col-sm-8">@Model.EmployeeNo</dd>
    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@Model.Department</dd>
    <dt class="col-sm-4">Position</dt><dd class="col-sm-8">@Model.Position</dd>
    <dt class="col-sm-4">Category</dt><dd class="col-sm-8">@(Model.Category == EmployeeCategory.AE ? "AE/Sales/SA" : "Staff")</dd>
    <dt class="col-sm-4">Join Date</dt><dd class="col-sm-8">@Model.JoinDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
</dl>
<h4 class="mt-4">Attachments</h4>
@if (Model.Attachments.Count == 0)
{
    <p class="text-muted">No files uploaded.</p>
}
else
{
    <div class="row g-3">
    @foreach (var attachment in Model.Attachments)
    {
        var isImage = attachment.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true
            || attachment.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
            || attachment.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
            || attachment.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
        <div class="col-sm-6 col-md-4">
            <div class="card h-100">
                @if (isImage)
                {
                    <a asp-action="Attachment" asp-route-employeeId="@Model.Id" asp-route-attachmentId="@attachment.Id" target="_blank">
                        <img class="card-img-top object-fit-contain p-2" style="height: 200px"
                             src="@Url.Action("Attachment", "Employees", new { employeeId = Model.Id, attachmentId = attachment.Id })"
                             alt="@attachment.FileName" />
                    </a>
                }
                <div class="card-body">
                    <div class="card-title text-break">@attachment.FileName</div>
                    <small class="text-muted">@(attachment.FileSize / 1024) KB</small>
                </div>
                @if (!isImage)
                {
                    <div class="card-footer bg-white">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Attachment"
                           asp-route-employeeId="@Model.Id" asp-route-attachmentId="@attachment.Id" target="_blank">Open</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Attachment"
                           asp-route-employeeId="@Model.Id" asp-route-attachmentId="@attachment.Id" asp-route-download="true">Download</a>
                    </div>
                }
            </div>
        </div>
    }
    </div>
}
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
