@model EmployeeDto
@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>
<hr />
<dl class="row col-md-6">
    <dt class="col-sm-4">Employee No.</dt><dd class="col-sm-8">@Model.EmployeeNo</dd>
    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@Model.Department</dd>
    <dt class="col-sm-4">Position</dt><dd class="col-sm-8">@Model.Position</dd>
    <dt class="col-sm-4">Join Date</dt><dd class="col-sm-8">@Model.JoinDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
