@using Microsoft.AspNetCore.Mvc.Rendering
@model CreateRequestDto
@{
    ViewData["Title"] = "New Account Request";
    var employees = ViewBag.Employees as List<SelectListItem>;
    var requestTypes = ViewBag.RequestTypes as List<SelectListItem>;
    var accountTypes = ViewBag.AccountTypes as IEnumerable<dynamic>;
}

<h2>New Account Request</h2>
<hr />

<form asp-action="Create" method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Employee</label>
        <select asp-for="EmployeeId" class="form-select" asp-items="employees">
            <option value="">-- select employee --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Request Type</label>
        <select asp-for="RequestType" class="form-select" asp-items="requestTypes"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Account Types</label>
        <div class="border rounded p-3">
            @foreach (var at in accountTypes!)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="AccountTypeIds"
                           value="@at.Id" id="at_@at.Id" />
                    <label class="form-check-label" for="at_@at.Id">@at.Name</label>
                </div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Remark" class="form-label">Remark</label>
        <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Create Draft</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
