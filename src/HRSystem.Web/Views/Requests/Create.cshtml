@using Microsoft.AspNetCore.Mvc.Rendering
@using HRSystem.Application.DTOs
@model CreateRequestDto
@{
    ViewData["Title"] = "New Account Request";
    var employees = ViewBag.Employees as List<SelectListItem>;
    var requestTypes = ViewBag.RequestTypes as List<SelectListItem>;
    var groups = ViewBag.AccountTypeGroups as List<IGrouping<string, AccountTypeOptionDto>> ?? new();
    var employee = ViewBag.SelectedEmployee as EmployeeDto;
    var isAe = employee?.Category == EmployeeCategory.AE;
    var formName = employee is null ? null : (isAe ? "STAFF REQUISITION FORM \u2013 AE/SALES/SA" : "STAFF REQUISITION FORM \u2013 Staff");
}

<style>
    /* Mirrors the printed "Staff Requisition Form" / "AE-Sales-SA Requisition
       Form" layout: an outer bordered sheet, a grey section title bar,
       underlined department headings, and blank-line style read-only fields. */
    .req-form { border: 1px solid #333; }
    .req-form .req-title { text-align: center; font-weight: bold; padding: .75rem; border-bottom: 1px solid #333; }
    .req-form .req-fields { padding: .75rem 1rem; border-bottom: 1px solid #333; }
    .req-bar { background: #d9d9d9; font-weight: bold; text-align: center; padding: .4rem .75rem; border-bottom: 1px solid #333; }
    .req-dept { padding: .6rem 1rem; border-bottom: 1px solid #333; }
    .req-dept:last-child { border-bottom: none; }
    .req-dept h6 { text-decoration: underline; margin-bottom: .5rem; }
    .req-line { border: 0; border-bottom: 1px solid #333; background: transparent; padding: 0 .25rem; }
    .req-static-line { display: inline-block; min-width: 180px; border-bottom: 1px solid #333; }
    .req-footer { padding: .75rem 1rem; }
</style>

<h2>New Account Request</h2>
<hr />

<form asp-action="Create" method="post" class="col-md-9">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Employee</label>
            <select asp-for="EmployeeId" class="form-select"
                    asp-items="employees" onchange="if (this.value) location.href='@Url.Action("Create")?employeeId=' + this.value">
                <option value="">-- select employee --</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Request Type</label>
            <select asp-for="RequestType" id="requestType" class="form-select" asp-items="requestTypes"></select>
        </div>
    </div>

    @if (employee is null)
    {
        <div class="alert alert-info">Select an employee above to load the matching requisition form (Staff, or AE/Sales/SA).</div>
    }
    else
    {
        <div class="req-form mb-3">
            <div class="req-title">@formName</div>

            <div class="req-fields">
                <div class="row mb-2">
                    <div class="col-md-6">Name: <span class="req-static-line">@employee.Name</span></div>
                    <div class="col-md-6">@(isAe ? "Location" : "Department"): <span class="req-static-line">@employee.Department</span></div>
                </div>
                <div class="row">
                    <div class="col-md-6">@(isAe ? "Title" : "Position"): <span class="req-static-line">@employee.Position</span></div>
                    <div class="col-md-6">Commencement Date: <span class="req-static-line">@employee.JoinDate.ToString("yyyy-MM-dd")</span></div>
                </div>

                @if (!isAe)
                {
                    <div class="mt-3" id="headcountSection">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="HeadcountOption" id="hcNew" value="new" checked="@(Model.IsNewHeadcount != false)" />
                            <label class="form-check-label" for="hcNew">New Headcount</label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-2">
                            <input class="form-check-input" type="radio" name="HeadcountOption" id="hcReplace" value="replace" checked="@(Model.IsNewHeadcount == false)" />
                            <label class="form-check-label" for="hcReplace">Replacement of</label>
                            <input asp-for="ReplacementOf" class="form-control form-control-sm req-line" style="max-width:220px" placeholder="name of employee replaced" />
                            <label class="ms-3 mb-0">Last day</label>
                            <input asp-for="LastDay" type="date" class="form-control form-control-sm req-line" style="max-width:160px" />
                        </div>
                        <input type="hidden" name="IsNewHeadcount" id="isNewHeadcount" value="@((Model.IsNewHeadcount != false).ToString().ToLowerInvariant())" />
                    </div>
                }
            </div>

            <div class="req-bar">Items Requested by @(isAe ? "Team Head / Branch Manager" : "Related Department Head")</div>

            @foreach (var group in groups)
            {
                var accessRightItems = group.Where(a => a.Name.StartsWith("Access Right - ")).OrderBy(a => a.SortOrder).ToList();
                var normalItems = group.Where(a => !a.Name.StartsWith("Access Right - ")).OrderBy(a => a.SortOrder).ToList();
                var pairUp = normalItems.Count <= 2;
                <div class="req-dept">
                    <h6>@group.Key</h6>
                    <div class="row">
                        @foreach (var at in normalItems)
                        {
                            <div class="@(pairUp ? "col-md-6" : "col-md-12")">
                                <div class="form-check d-flex align-items-center gap-2 mb-1 flex-wrap">
                                    <input class="form-check-input" type="checkbox" name="AccountTypeIds"
                                           value="@at.Id" id="at_@at.Id" />
                                    <label class="form-check-label" for="at_@at.Id">@at.Name</label>
                                    @if (at.RequiresDetail)
                                    {
                                        <span>(@at.DetailLabel:</span>
                                        <input name="Details[@at.Id]" class="form-control form-control-sm req-line" style="max-width:220px" />
                                        <span>)</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (accessRightItems.Count > 0)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                            <span>Access Right to</span>
                            @foreach (var at in accessRightItems)
                            {
                                <div class="form-check d-flex align-items-center gap-1 mb-0">
                                    <input class="form-check-input" type="checkbox" name="AccountTypeIds"
                                           value="@at.Id" id="at_@at.Id" />
                                    <label class="form-check-label" for="at_@at.Id">@at.Name["Access Right - ".Length..]</label>
                                </div>
                            }
                            <span class="text-muted small">(not applicable to Branches)</span>
                        </div>
                    }
                </div>
            }

            <div class="req-footer">
                @if (isAe)
                {
                    <p class="mb-3">Requested by Team Head/Branch Manager: <span class="req-static-line">&nbsp;</span></p>
                    <p class="mb-3">Approved by CEO/ED/GM: <span class="req-static-line">&nbsp;</span> &nbsp; Date: <span class="req-static-line" style="min-width:120px">&nbsp;</span></p>
                }
                else
                {
                    <p class="mb-1">Requested by (Department / Team Head)</p>
                    <p class="mb-3">Name: <span class="req-static-line">&nbsp;</span> &nbsp; Signature: <span class="req-static-line">&nbsp;</span></p>
                    <p class="mb-3">Approved by CEO/ED/GM: <span class="req-static-line">&nbsp;</span> &nbsp; Date: <span class="req-static-line" style="min-width:120px">&nbsp;</span></p>
                }
            </div>

            @if (isAe)
            {
                <div class="req-bar">For the Use of Different Departments</div>
                <div class="req-footer">
                    <p class="mb-3">Acknowledged by Department Heads: <span class="req-static-line">&nbsp;</span></p>
                    <div class="mb-1">
                        <label asp-for="Remark" class="form-label">Remarks:</label>
                        <textarea asp-for="Remark" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            }
        </div>
    }

    @if (employee is null || !isAe)
    {
        <div class="mb-3">
            <label asp-for="Remark" class="form-label">Remark</label>
            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
        </div>
    }

    <button type="submit" class="btn btn-primary">Create Draft</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle "Replacement of / Last day" vs. "New Headcount" and keep the
        // hidden IsNewHeadcount flag (posted with the form) in sync.
        (function () {
            var newRadio = document.getElementById('hcNew');
            var replaceRadio = document.getElementById('hcReplace');
            var flag = document.getElementById('isNewHeadcount');
            if (!newRadio || !replaceRadio || !flag) return;
            function sync() { flag.value = newRadio.checked ? 'true' : 'false'; }
            newRadio.addEventListener('change', sync);
            replaceRadio.addEventListener('change', sync);
        })();
    </script>
}
