<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var kind = Context.Request.Query["kind"].ToString();

    // Checklist templates belong to Onboarding or Departures depending on their kind.
    string Active(string c, string? a = null)
    {
        var current = string.Equals(controller, "ChecklistTemplates", StringComparison.OrdinalIgnoreCase)
            ? (string.Equals(kind, "Onboarding", StringComparison.OrdinalIgnoreCase) ? "Onboarding" : "Departures")
            : controller;
        return string.Equals(current, c, StringComparison.OrdinalIgnoreCase)
               && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    }

    var hrMenu = User.HasPermission(Permissions.EmployeesManage) || User.HasPermission(Permissions.DepartmentsManage)
                 || User.HasPermission(Permissions.OnboardingManage) || User.HasPermission(Permissions.DeparturesManage);
    var settingsMenu = User.HasPermission(Permissions.UsersManage) || User.HasPermission(Permissions.RolesManage)
                       || User.HasPermission(Permissions.SystemJobs);
}

@if (!signedIn)
{
    <nav class="navbar navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">HR System</a>
            <a class="nav-link text-white-50" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </div>
    </nav>
    <div class="container">
        <partial name="_Alerts" />
        <main role="main">@RenderBody()</main>
    </div>
}
else
{
    <div class="d-flex">
        <aside class="sidebar offcanvas-lg offcanvas-start text-bg-dark" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title" id="sidebarLabel">HR System</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <a class="sidebar-brand d-none d-lg-block" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-people-fill me-2"></i>HR System
                </a>

                <nav class="nav flex-column py-2">
                    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i>Home</a>

                    <div class="sidebar-heading">Workspace</div>
                    <a class="nav-link @Active("Requests")" asp-controller="Requests" asp-action="Index"><i class="bi bi-person-badge"></i>Account Requests</a>
                    <a class="nav-link @Active("MyTasks")" asp-controller="MyTasks" asp-action="Index"><i class="bi bi-check2-square"></i>My Tasks</a>
                    <a class="nav-link @Active("ChecklistTasks")" asp-controller="ChecklistTasks" asp-action="Index"><i class="bi bi-list-check"></i>My Checklist Tasks</a>

                    @if (hrMenu)
                    {
                        <div class="sidebar-heading">HR</div>
                        @if (User.HasPermission(Permissions.EmployeesManage))
                        {
                            <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-lines-fill"></i>Employees</a>
                        }
                        @if (User.HasPermission(Permissions.DepartmentsManage))
                        {
                            <a class="nav-link @Active("Departments")" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i>Departments</a>
                        }
                        @if (User.HasPermission(Permissions.OnboardingManage))
                        {
                            <a class="nav-link @Active("Onboarding")" asp-controller="Onboarding" asp-action="Index"><i class="bi bi-box-arrow-in-right"></i>Onboarding</a>
                        }
                        @if (User.HasPermission(Permissions.DeparturesManage))
                        {
                            <a class="nav-link @Active("Departures")" asp-controller="Departures" asp-action="Index"><i class="bi bi-box-arrow-right"></i>Departures</a>
                        }
                    }

                    @if (settingsMenu)
                    {
                        <div class="sidebar-heading">Settings</div>
                        @if (User.HasPermission(Permissions.UsersManage))
                        {
                            <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i>Users</a>
                        }
                        @if (User.HasPermission(Permissions.RolesManage))
                        {
                            <a class="nav-link @Active("Roles")" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i>Roles &amp; Permissions</a>
                        }
                        @if (User.HasPermission(Permissions.SystemJobs))
                        {
                            <a class="nav-link" href="~/hangfire"><i class="bi bi-clock-history"></i>Background Jobs</a>
                        }
                    }
                </nav>

                <div class="sidebar-user mt-auto">
                    <div class="small text-white-50 text-truncate" title="@User.Identity!.Name"><i class="bi bi-person-circle me-1"></i>@User.Identity!.Name</div>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-light w-100 mt-2"><i class="bi bi-box-arrow-left me-1"></i>Logout</button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="flex-grow-1 min-w-0 d-flex flex-column">
            <nav class="navbar navbar-dark bg-dark d-lg-none">
                <div class="container-fluid">
                    <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="navbar-brand ms-2 me-auto" asp-controller="Home" asp-action="Index">HR System</a>
                </div>
            </nav>
            <div class="container-fluid px-4 py-3 flex-grow-1">
                <partial name="_Alerts" />
                <main role="main">@RenderBody()</main>
            </div>
            <footer class="border-top text-muted text-center py-3">
                <div class="small">&copy; @DateTime.Now.Year - HR System &middot; ASP.NET Core 8.0</div>
            </footer>
        </div>
    </div>
}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
