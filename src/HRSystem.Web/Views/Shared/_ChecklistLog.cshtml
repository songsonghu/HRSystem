@model IReadOnlyList<ChecklistLogDto>
@* The request's workflow log: every step, who took it, and their remark. Shown at the bottom of the departure pages. *@
<h4 class="mt-4">Workflow Log</h4>
@if (Model.Count == 0)
{
    <p class="text-muted">No steps recorded yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr><th style="width:150px">Time</th><th>Step</th><th>Department(s)</th><th>By</th><th>Remark</th></tr>
            </thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr class="@(log.IsReturn ? "table-warning" : log.Action == ChecklistLogAction.ManagementApproved ? "table-success" : "")">
                    <td class="text-nowrap">@log.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@log.Step</td>
                    <td>@log.Departments</td>
                    <td>@log.UserName</td>
                    <td style="white-space:pre-line">@log.Remark</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
