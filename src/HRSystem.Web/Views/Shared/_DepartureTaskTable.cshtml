@model IReadOnlyList<ChecklistTaskDto>
<table class="table table-hover align-middle">
    <thead>
        <tr><th>Request</th><th>Employee</th><th>Department</th><th>Task</th><th>Completed At</th><th>Approval</th><th>Request Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.RequestNo</td>
            <td>@t.EmployeeName (@t.EmployeeNo)</td>
            <td>@t.DepartmentName</td>
            <td>@t.Status</td>
            <td>@t.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                @if (t.IsApproved)
                {
                    <span title="@t.ApprovedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">Approved by @t.ApprovedByName</span>
                }
                else if (t.IsDone)
                {
                    <span class="text-warning-emphasis">Waiting</span>
                }
            </td>
            <td><partial name="_ChecklistStatusBadge" model="t.RequestStatus" /></td>
            <td class="text-nowrap text-end">
                <a class="btn btn-sm btn-outline-primary" asp-controller="ChecklistTasks" asp-action="Task" asp-route-id="@t.Id">View</a>
                @if (t.CanReopen)
                {
                    <form asp-controller="ChecklistTasks" asp-action="Reopen" asp-route-id="@t.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Take this task back? It returns to In Progress until it is completed again.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Take Back</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="8" class="text-muted">No tasks found.</td></tr>
    }
    </tbody>
</table>
