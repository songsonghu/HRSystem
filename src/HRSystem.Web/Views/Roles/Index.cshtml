@model IReadOnlyList<RoleListItemDto>
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Roles</h2>
    <a class="btn btn-success" asp-action="Create">+ New Role</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Role</th><th>Users</th><th>Permissions</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>
                @r.Name
                @if (r.IsProtected) { <span class="badge bg-dark ms-1">built-in</span> }
            </td>
            <td>@r.UserCount</td>
            <td>
                @if (r.IsProtected)
                {
                    <span class="text-muted">All permissions</span>
                }
                else if (r.Permissions.Count == 0)
                {
                    <span class="text-muted">None</span>
                }
                else
                {
                    @foreach (var p in r.Permissions)
                    {
                        <span class="badge bg-light text-dark border">@p</span>
                    }
                }
            </td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">@(r.IsProtected ? "View" : "Edit")</a>
                @if (!r.IsProtected)
                {
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this role?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
