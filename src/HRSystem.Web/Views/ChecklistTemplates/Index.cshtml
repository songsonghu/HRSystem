@model IReadOnlyList<ChecklistTemplateListItemDto>
@{
    var kind = (ChecklistKind)ViewBag.Kind;
    ViewData["Title"] = "Templates for Departure";
    var canEditTemplates = (bool)ViewBag.CanEditTemplates;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        @if (canEditTemplates)
        {
            <a class="btn btn-success" asp-action="Create" asp-route-kind="@kind">+ New Template</a>
        }
    </div>
</div>

<p class="text-muted">
    Each department below receives a checklist task when a departure is submitted: its handlers complete it under Departure Checklist,
    then any of its approvers approves it under Departure Approval. Click <b>Edit</b> to change a department's checklist, handlers and approvers.
    Checklist changes apply to requests submitted afterwards.
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Order</th><th>Department</th><th>Handlers</th><th>Approvers</th><th>Items</th><th>Required</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.SortOrder</td>
            <td>@t.DepartmentName</td>
            <td><partial name="_AssigneeNames" model="t.HandlerNames ?? string.Empty" /></td>
            <td><partial name="_AssigneeNames" model="t.ApproverNames ?? string.Empty" /></td>
            <td>@t.ItemCount</td>
            <td>@(t.IsRequired ? "Yes" : "No")</td>
            <td><span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">@(t.IsActive ? "Active" : "Inactive")</span></td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                @if (canEditTemplates)
                {
                <form asp-action="Delete" asp-route-id="@t.Id" asp-route-kind="@kind" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this checklist template? Submitted requests are not affected.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="8" class="text-muted">No templates yet.</td></tr>
    }
    </tbody>
</table>
