@model IReadOnlyList<UserListItemDto>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    <a class="btn btn-success" asp-action="Create">+ New User</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search email / name" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Email</th><th>Name</th><th>Roles</th><th>Employee</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>@u.FullName</td>
            <td>
                @foreach (var role in u.Roles)
                {
                    <span class="badge bg-light text-dark border">@role</span>
                }
            </td>
            <td>@(u.EmployeeDisplay ?? "—")</td>
            <td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Active" : "Disabled")</span></td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this user? This cannot be undone. Consider disabling the user instead.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="6" class="text-muted">No users found.</td></tr>
    }
    </tbody>
</table>
