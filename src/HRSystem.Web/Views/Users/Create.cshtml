@model UserEditDto
@{
    ViewData["Title"] = "New User";
}

<h2>New User</h2>
<hr />

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <partial name="_UserFields" model="Model" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Initial Password</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <div class="form-text">At least 8 characters with an uppercase letter, a lowercase letter and a digit.</div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
