@model UserEditDto
@{
    var roleOptions = (IReadOnlyList<string>)ViewBag.RoleOptions;
}

<div class="mb-3">
    <label asp-for="Email" class="form-label">Email (login name)</label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="FullName" class="form-label">Full Name</label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label class="form-label d-block">Roles</label>
    @for (int i = 0; i < roleOptions.Count; i++)
    {
        var role = roleOptions[i];
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="Roles" value="@role" id="role-@i"
                   @(Model.Roles.Contains(role) ? "checked" : "") />
            <label class="form-check-label" for="role-@i">@role</label>
        </div>
    }
</div>
<div class="mb-3">
    <label asp-for="EmployeeId" class="form-label">Linked Employee</label>
    <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeOptions">
        <option value="">-- not linked --</option>
    </select>
    <div class="form-text">The employee record this login belongs to. Required for employee self-service.</div>
</div>
<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Active (can sign in)</label>
</div>
