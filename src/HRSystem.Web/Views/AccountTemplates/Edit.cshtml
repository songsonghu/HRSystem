@model AccountTemplateEditDto
@{
    ViewData["Title"] = "Templates for Accounts - " + Model.DepartmentName;
    var canEditTypes = (bool)ViewBag.CanEditTypes;
    var assignees = (AssigneesEditorViewModel)ViewBag.Assignees;
    var assigneeView = new ViewDataDictionary(ViewData) { ["AreaLabel"] = "Account" };
}

<h2>@ViewData["Title"]</h2>
<h5>Account types</h5>
<p class="text-muted">
    Fill a blank row to add an account type. Account types are never deleted because requests and employee accounts refer to them;
    untick <b>Active</b> to stop offering one. <b>Form</b> chooses which requisition form shows it; <b>Detail</b> asks HR for extra information
    (e.g. an access profile) when requesting it. Leave <b>Code</b> empty to generate it from the name.
</p>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="DepartmentId" />
    <input type="hidden" asp-for="DepartmentName" />

    <fieldset disabled="@(!canEditTypes)">
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:80px">Order</th>
                    <th>Name</th>
                    <th style="width:150px">Code</th>
                    <th style="width:140px">Form</th>
                    <th style="width:220px">Detail</th>
                    <th style="width:70px" class="text-center">Active</th>
                </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" asp-for="Rows[i].Id" />
                        <input type="hidden" asp-for="Rows[i].Description" />
                        <input asp-for="Rows[i].SortOrder" class="form-control form-control-sm" type="number" />
                    </td>
                    <td><input asp-for="Rows[i].Name" class="form-control form-control-sm" maxlength="100" /></td>
                    <td><input asp-for="Rows[i].Code" class="form-control form-control-sm" maxlength="50" /></td>
                    <td>
                        <select asp-for="Rows[i].Audience" class="form-select form-select-sm">
                            <option value="@AccountTypeAudience.Both">Both</option>
                            <option value="@AccountTypeAudience.StaffOnly">Staff only</option>
                            <option value="@AccountTypeAudience.AEOnly">AE/Sales/SA only</option>
                        </select>
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><input asp-for="Rows[i].RequiresDetail" class="form-check-input mt-0" title="Ask HR for a detail" /></span>
                            <input asp-for="Rows[i].DetailLabel" class="form-control" placeholder="label, e.g. Access profile" maxlength="100" />
                        </div>
                    </td>
                    <td class="text-center"><input asp-for="Rows[i].IsActive" class="form-check-input" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </fieldset>

    <partial name="_AssigneesEditor" model="assignees" view-data="assigneeView" />

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    @if (assignees.CanEdit)
    {
        <partial name="_UserPickerScript" />
    }
}
