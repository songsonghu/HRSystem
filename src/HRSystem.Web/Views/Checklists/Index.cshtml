@using Microsoft.AspNetCore.Mvc.Rendering
@model IReadOnlyList<ChecklistRequestDto>
@{
    var kind = (ChecklistKind)ViewBag.Kind;
    var isOnboarding = kind == ChecklistKind.Onboarding;
    var employees = (List<SelectListItem>)ViewBag.Employees;
    ViewData["Title"] = isOnboarding ? "Onboarding" : "Departure Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a class="btn btn-outline-secondary" asp-controller="ChecklistTemplates" asp-action="Index" asp-route-kind="@kind">Checklist Templates</a>
</div>

<form method="get" asp-action="Create" class="row g-2 mb-4">
    <div class="col-md-5">
        <select name="employeeId" class="form-select" asp-items="employees" required>
            <option value="">-- select employee --</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-success">@(isOnboarding ? "+ Start Onboarding" : "+ Start Departure")</button>
    </div>
    <div class="col-12 form-text">
        @(isOnboarding
            ? "Only active employees without an open onboarding are listed. Create the employee record first."
            : "Only active employees without an open departure are listed.")
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No requests yet.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Request No.</th>
                <th>Employee</th>
                <th>Status</th>
                @if (isOnboarding)
                {
                    <th>Start Date</th>
                }
                else
                {
                    <th>Last Working Date</th>
                    <th>Last Employment Date</th>
                }
                <th>Accounts</th>
                <th>Tasks Done</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            var done = r.Tasks.Count(t => t.Status is ChecklistTaskStatus.Completed or ChecklistTaskStatus.NotApplicable);
            <tr>
                <td>@r.RequestNo</td>
                <td>@r.EmployeeName (@r.EmployeeNo)</td>
                <td><partial name="_ChecklistStatusBadge" model="r.Status" /></td>
                @if (isOnboarding)
                {
                    <td>@r.StartDate?.ToString("yyyy-MM-dd")</td>
                }
                else
                {
                    <td>@r.LastWorkingDate?.ToString("yyyy-MM-dd")</td>
                    <td>@r.LastEmploymentDate?.ToString("yyyy-MM-dd")</td>
                }
                <td>@(r.AccountRequestStatus?.ToString() ?? "—")</td>
                <td>@done / @r.Tasks.Count</td>
                <td>@r.SubmittedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
