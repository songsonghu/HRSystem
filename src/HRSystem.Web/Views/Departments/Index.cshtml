@model IReadOnlyList<DepartmentListItemDto>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Departments</h2>
    <a class="btn btn-success" asp-action="Create">+ New Department</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Department</th><th>Code</th><th>Manager</th><th>Employees</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@d.Id">@d.Name</a></td>
            <td>@d.Code</td>
            <td>
                @if (d.ManagerName is null)
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    @d.ManagerName
                    @if (!d.ManagerCanReceiveTasks)
                    {
                        <span class="badge bg-warning text-dark ms-1" title="The manager has no login account, so tasks cannot be assigned to this department.">no login</span>
                    }
                }
            </td>
            <td>@d.EmployeeCount</td>
            <td><span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span></td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this department? Departments that are in use can only be deactivated.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
