@using Microsoft.AspNetCore.Mvc.Rendering
@model ChecklistRequestDto
@{
    ViewData["Title"] = "Final Review " + Model.RequestNo;
    var canDecide = Model.Status == ChecklistStatus.PendingFinalReview;
    var accountsPending = Model.AccountRequestStatus is not null and not RequestStatus.Completed;
    var returnable = Model.Tasks.Where(t => t.IsDone).OrderBy(t => t.SortOrder)
        .Select(t => new SelectListItem(t.DepartmentName, t.Id.ToString())).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Departure Final Review · @Model.RequestNo</h2>
    <span class="fs-6"><partial name="_ChecklistStatusBadge" model="Model.Status" /></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><b>Employee</b><br />@Model.EmployeeName (@Model.EmployeeNo)</div>
    <div class="col-md-3"><b>Last Working Date</b><br />@Model.LastWorkingDate?.ToString("yyyy-MM-dd")</div>
    <div class="col-md-3"><b>Last Employment Date</b><br />@Model.LastEmploymentDate?.ToString("yyyy-MM-dd")</div>
    <div class="col-md-3">
        <b>Accounts to Disable</b><br />
        @if (Model.AccountRequestId is not null)
        {
            @Model.AccountRequestNo <partial name="~/Views/Requests/_RequestStatusBadge.cshtml" model="Model.AccountRequestStatus!.Value" />
        }
        else
        {
            <span class="text-muted">None</span>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Reason))
{
    <p><b>Reason:</b> @Model.Reason</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Remark))
{
    <p><b>Remark:</b> @Model.Remark</p>
}
@if (Model.Status == ChecklistStatus.Cancelled)
{
    <div class="alert alert-secondary"><b>Cancelled</b> @Model.CancelledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @Model.CancelReason</div>
}
@if (canDecide && accountsPending)
{
    <div class="alert alert-warning">Account request @Model.AccountRequestNo is not completed yet, so the departure cannot be approved.</div>
}

<h4>Department Checklists</h4>
@foreach (var t in Model.Tasks.OrderBy(x => x.SortOrder))
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <span><b>@t.DepartmentName</b> @if (!t.IsRequired) { <span class="badge bg-secondary ms-1">optional</span> }</span>
            <span>
                <span class="badge @(t.IsDone ? "bg-success" : "bg-warning text-dark")">@t.Status</span>
                <span class="text-muted small ms-2">@t.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </span>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var i in t.Items)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>
                        @if (i.IsCompleted) { <i class="bi bi-check-circle-fill text-success me-1"></i> }
                        else if (i.IsNotApplicable) { <i class="bi bi-dash-circle text-secondary me-1"></i> }
                        else { <i class="bi bi-circle text-muted me-1"></i> }
                        @i.Description
                        @if (i.IsNotApplicable) { <span class="text-muted small">(N/A)</span> }
                    </span>
                    <span class="text-muted small">@i.Remark</span>
                </li>
            }
        </ul>
        @if (!string.IsNullOrWhiteSpace(t.TaskRemark))
        {
            <div class="card-footer small"><b>Remark:</b> @t.TaskRemark</div>
        }
    </div>
}

@if (canDecide)
{
    <div class="d-flex gap-2 align-items-start mb-3">
        <form asp-action="Approve" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Approve this departure? The request is completed and the employee is marked as resigned.');">
            <button class="btn btn-success" disabled="@accountsPending">Approve Departure</button>
        </form>
        @if (returnable.Count > 0)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#return-task">Return to Department</button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (returnable.Count > 0)
    {
        <div class="collapse mb-3" id="return-task">
            <div class="card card-body">
                <form asp-action="ReturnTask" method="post">
                    <input type="hidden" name="requestId" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label" for="taskId">Department</label>
                            <select class="form-select" id="taskId" name="taskId" asp-items="returnable"></select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="reason">What needs to be fixed</label>
                            <textarea class="form-control" id="reason" name="reason" rows="2" maxlength="500" required></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-danger mt-2">Return Task</button>
                </form>
            </div>
        </div>
    }
}
else
{
    <a asp-action="@(Model.Status is ChecklistStatus.Completed or ChecklistStatus.Cancelled ? "History" : "Index")" class="btn btn-outline-secondary">Back</a>
}
